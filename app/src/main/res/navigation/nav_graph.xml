<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.flash.smasharena.presentation.login.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.flash.smasharena.presentation.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_homeFragment_to_slotsFragment"
            app:destination="@id/slotsFragment" />
    </fragment>

    <fragment
        android:id="@+id/slotsFragment"
        android:name="com.flash.smasharena.presentation.slots.SlotsFragment"
        android:label="Slots">
        <argument
            android:name="facilityId"
            app:argType="string" />
        <argument
            android:name="facilityName"
            app:argType="string" />
    </fragment>

</navigation>
