<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmashArena" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/accent_green_dark</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="materialAlertDialogTheme">@style/Theme.SmashArena.Dialog</item>
    </style>

    <!-- Dark dialog overlay — used by all MaterialAlertDialogBuilder calls -->
    <style name="Theme.SmashArena.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent_green</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.SmashArena.Dialog.PositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.SmashArena.Dialog.NegativeButton</item>
    </style>

    <style name="Theme.SmashArena.Dialog.PositiveButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_green</item>
    </style>

    <style name="Theme.SmashArena.Dialog.NegativeButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Theme.SmashArena.ResultDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/Theme.SmashArena.ResultDialog.WindowAnimation</item>
    </style>

    <style name="Theme.SmashArena.ResultDialog.WindowAnimation" parent="android:Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="TextAppearance.SmashArena.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>
